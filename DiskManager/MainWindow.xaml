<Window x:Class="DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="磁盘文件管理器" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabControl">
            <TabItem Header="磁盘概览">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="磁盘空间概览" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListView x:Name="DiskListView" ItemsSource="{Binding Disks}" Margin="0,0,0,20">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="盘符" Width="80" DisplayMemberBinding="{Binding DriveLetter}"/>
                                    <GridViewColumn Header="名称" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="总容量" Width="100" DisplayMemberBinding="{Binding TotalSizeFormatted}"/>
                                    <GridViewColumn Header="已使用" Width="100" DisplayMemberBinding="{Binding UsedSpaceFormatted}"/>
                                    <GridViewColumn Header="剩余空间" Width="100" DisplayMemberBinding="{Binding FreeSpaceFormatted}"/>
                                    <GridViewColumn Header="使用率" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" Height="20" Width="80"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="刷新磁盘信息" Command="{Binding RefreshDisksCommand}" Width="120" HorizontalAlignment="Left"/>

                        <TextBlock Text="空间使用趋势" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <TextBlock Text="{Binding TrendText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="操作日志" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <ListView x:Name="LogListView" ItemsSource="{Binding Logs}" Height="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                                    <GridViewColumn Header="操作" Width="100" DisplayMemberBinding="{Binding Operation}"/>
                                    <GridViewColumn Header="详情" Width="360" DisplayMemberBinding="{Binding Details}"/>
                                    <GridViewColumn Header="状态" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsSuccess, Converter={StaticResource BooleanToStatusConverter}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="大文件">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="扫描路径:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="300" Margin="0,0,10,0"
                                 Text="{Binding LargeFileScanPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="最小文件大小(MB):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="80" Margin="0,0,10,0"
                                 Text="{Binding MinFileSizeText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="扫描大文件" Command="{Binding ScanLargeFilesCommand}" Width="100"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="LargeFilesListView" ItemsSource="{Binding LargeFiles}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="选择" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件名" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="路径" Width="400" DisplayMemberBinding="{Binding FullPath}"/>
                                <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm'}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="删除选中文件" Command="{Binding DeleteLargeFilesCommand}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="打开文件位置" Width="120"
                                Command="{Binding OpenFileLocationCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LargeFilesListView}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="重复文件">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="扫描路径:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="300" Margin="0,0,10,0"
                                 Text="{Binding DuplicateScanPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="保留策略:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="160" Margin="0,0,10,0"
                                  ItemsSource="{Binding KeepStrategyOptions}"
                                  SelectedIndex="{Binding SelectedKeepStrategyIndex}"/>
                        <Button Content="扫描重复文件" Command="{Binding ScanDuplicatesCommand}" Width="120"/>
                    </StackPanel>

                    <TreeView Grid.Row="1" x:Name="DuplicateFilesTreeView" ItemsSource="{Binding DuplicateGroups}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Files}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text=" (" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding FileSizeFormatted}"/>
                                    <TextBlock Text=") - 浪费: " Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding TotalWastedSpaceFormatted}" Foreground="Red"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullPath}"/>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Button Grid.Row="2" Content="删除重复文件(按策略保留一个)" Command="{Binding DeleteDuplicatesCommand}"
                            Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="清理建议">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="目标磁盘:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="90" Margin="0,0,10,0"
                                      ItemsSource="{Binding Drives}"
                                      SelectedItem="{Binding SelectedCleanupDrive}"/>
                            <Button Content="扫描清理建议" Command="{Binding ScanCleanupCommand}" Width="120"/>
                        </StackPanel>

                        <ItemsControl x:Name="CleanupSuggestionsItemsControl" ItemsSource="{Binding CleanupSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text=" - " Margin="5,0,5,0"/>
                                                <TextBlock Text="{Binding Description}" Foreground="Gray"/>
                                                <TextBlock Text=" - " Margin="5,0,5,0"/>
                                                <TextBlock Text="{Binding TotalSizeFormatted}" Foreground="{Binding IsSafeToDelete, Converter={StaticResource BooleanToColorConverter}}"/>
                                                <TextBlock Text=" (" Margin="5,0,0,0"/>
                                                <TextBlock Text="{Binding FileCount}"/>
                                                <TextBlock Text=" 个文件)"/>
                                            </StackPanel>

                                            <Button Content="全选/全不选" Width="110" HorizontalAlignment="Left" Margin="0,5,0,5"
                                                    IsEnabled="{Binding CanSelectFiles}"
                                                    Command="{Binding DataContext.ToggleCleanupSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                            <ListView ItemsSource="{Binding Files}" Height="150" Margin="0,5,0,0">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="选择" Width="60">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding DataContext.CanSelectFiles, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Header="文件名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                                        <GridViewColumn Header="路径" Width="380" DisplayMemberBinding="{Binding FullPath}"/>
                                                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>

                                            <Button Content="{Binding ActionText}" Width="130" HorizontalAlignment="Right" Margin="0,10,0,0"
                                                    Command="{Binding DataContext.DeleteCleanupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="文件操作">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="添加文件" Command="{Binding AddFilesCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="添加文件夹" Command="{Binding AddFolderCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="清空列表" Command="{Binding ClearListCommand}" Width="100"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="同名冲突:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="160" ItemsSource="{Binding ConflictOptions}"
                                  SelectedIndex="{Binding SelectedConflictIndex}"/>
                    </StackPanel>

                    <ListView Grid.Row="2" x:Name="FileOperationListView" ItemsSource="{Binding FileOperationItems}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="选择" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="路径" Width="420" DisplayMemberBinding="{Binding FullPath}"/>
                                <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="类型" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsDirectory, Converter={StaticResource BooleanToTypeConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="批量复制" Command="{Binding BatchCopyCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="批量移动" Command="{Binding BatchMoveCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="批量删除" Command="{Binding BatchDeleteCommand}" Width="100"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="150" Margin="0,0,10,0"
                              ItemsSource="{Binding DeleteModeOptions}"
                              SelectedIndex="{Binding SelectedDeleteModeIndex}"/>
                    <Button Content="取消" Width="70" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar Width="200" Height="18"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>