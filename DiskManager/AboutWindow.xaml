<Window x:Class="DiskManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 磁盘文件管理器" Height="380" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13">
    <StackPanel Margin="24">
        <TextBlock Text="磁盘文件管理器" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="#666666"/>
        <TextBlock Text="便携式 Windows 磁盘与文件管理工具" Margin="0,12,0,0"/>
        <TextBlock x:Name="RuntimeText" Margin="0,4,0,0" Foreground="#666666"/>
        <TextBlock x:Name="PrivilegeText" Margin="0,4,0,0" Foreground="#666666" TextWrapping="Wrap"/>

        <TextBlock Text="日志目录" FontWeight="Bold" Margin="0,18,0,4"/>
        <TextBox x:Name="LogPathText" IsReadOnly="True" Background="#F5F5F5"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="项目地址：" VerticalAlignment="Center"/>
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/karlmoriaty/DiskFileManager"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    github.com/karlmoriaty/DiskFileManager
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="打开日志目录" Width="110" Margin="0,0,8,0" Click="OpenLogFolder_Click"/>
            <Button Content="关闭" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>